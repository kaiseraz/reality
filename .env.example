# Copy to .env and fill in. The API key is read only by apps/server (trusted core);
# it must never be passed into sandboxes or sent to the browser.
ANTHROPIC_API_KEY=
# Meta Model API (Muse Spark). With this key set, Reality plans and writes analysis code with
# Meta's model (preferred over Claude). Sent only to the Meta API, as a bearer token.
# Check once with: cd apps/server && npx tsx --env-file=../../.env eval/meta-probe.ts --yes
META_MODEL_API_KEY=
# META_MODEL=muse-spark-1.3   (current model id from the Meta dashboard)
# What model use costs, per million tokens in and out, from your provider's price list.
# Mission budgets are counted in this unit; without it, in thousands of tokens.
# MODEL_PRICE_INPUT=0.5
# MODEL_PRICE_OUTPUT=2
# MODEL_PRICE_UNIT=credits
DATABASE_URL=postgres://reality:reality@localhost:5432/reality
SERVER_PORT=8787
# Accounts are on by default: the first visit creates the admin account.
# AUTH=off skips login (single user, local development only).
# AUTH=off

# Each bot's computer (AIO Sandbox desktop). Build the warm variant once with
#   npm run computer:build
# to have KiCad, FreeCAD and CadQuery already installed; without it, bots install
# the tools themselves on first use (2-4 minutes through the gateway).
COMPUTER_IMAGE=reality-computer:dev

# Optional: raises GitHub's limit of 60 requests an hour when bots look for skills.
# GITHUB_TOKEN=

# Encrypts API keys people give tool servers. Default: a generated key file in CAPABILITY_DIR.
# SECRET_KEY=

# Literature search (research steps). Default: the public OpenAlex API, no key needed.
# OPENALEX_URL=https://api.openalex.org/works
# Optional contact address for OpenAlex's faster "polite pool".
# OPENALEX_MAILTO=
