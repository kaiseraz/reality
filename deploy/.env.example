# Copy to deploy/.env and fill in. Never commit the filled-in file.

# Database password (long and random, e.g. openssl rand -base64 32).
POSTGRES_PASSWORD=

# Optional: enables the Claude planner and analyst.
ANTHROPIC_API_KEY=

# Group id of the Docker socket on the host: getent group docker | cut -d: -f3
DOCKER_GID=

# Host directory for artifacts, capability staging and run directories.
REALITY_DATA=/srv/reality

# Strongly recommended for servers with several users: install gVisor and set runsc.
SANDBOX_RUNTIME=

# Serve over HTTPS through a reverse proxy; keep true unless you test on plain http.
COOKIE_SECURE=true
BIND_ADDRESS=127.0.0.1
PORT=8787
